FROM node:22-alpine

WORKDIR /app

RUN addgroup -S -g 10001 app && adduser -S -D -H -u 10001 -G app app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_AUTH_TOKEN=""
ENV VITE_API_AUTH_TOKEN=${VITE_API_AUTH_TOKEN}

RUN npm run build:prod

RUN mkdir -p /frontend-dist && chown -R app:app /app /frontend-dist

USER app

CMD ["sh", "-c", "rm -rf /frontend-dist/* && cp -r /app/dist/. /frontend-dist/"]
