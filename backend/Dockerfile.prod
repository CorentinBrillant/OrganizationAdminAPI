FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /app

RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid 10001 --home /app app

COPY --from=ghcr.io/astral-sh/uv:0.11.16 /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project

COPY . .

RUN mkdir -p /app/staticfiles
RUN chown -R app:app /app /opt/venv

ENV PATH="/opt/venv/bin:$PATH"
ENV GUNICORN_BIND=0.0.0.0:8000
ENV GUNICORN_WORKERS=3
ENV GUNICORN_THREADS=2
ENV GUNICORN_TIMEOUT=60

EXPOSE 8000

USER app

CMD ["sh", "-c", "python manage.py migrate && python manage.py collectstatic --noinput && gunicorn backend.wsgi:application --bind ${GUNICORN_BIND} --workers ${GUNICORN_WORKERS} --threads ${GUNICORN_THREADS} --timeout ${GUNICORN_TIMEOUT}"]
